DATABASE_URL="postgresql://wff:wff@localhost:5434/wff_signal_map"

# Optional: enables real AI assistant responses via Anthropic. Falls back to a
# stubbed keyword-matched response when unset.
ANTHROPIC_API_KEY=

# Shared secret protecting the /admin/stories editor's write API. Unset is
# fine locally (the editor just works), but on a deployed instance an unset
# token disables editing entirely rather than leaving it open to anyone.
ADMIN_TOKEN=
